# Never in this repository: anything from the disc, saves, builds, keys.
# The app is launcher-based: the user selects their own .cue on first launch,
# so no disc data belongs here (or in the APK).
disc/
*.bin
*.BIN
*.cue
*.iso
*.chd
*.img
*.ecm
*.pbp
saves/
memcard-import/
*.mcd
*.pst

# Recompiler output (derived from the disc; regenerated by tools/regen.ps1)
generated/
generated.orig/
.regenerated

# Build outputs
build*/
android/.gradle/
android/app/.cxx/
android/app/build/
android/local.properties
android/build/
apk/
*.apk
*.keystore
*.jks
keys.txt

# AOT overlay cache (built from play captures; optional)
build-android-overlays/

# Downloaded build tools and dependency caches (llvm-mingw, Gradle, SDL3)
tools-cache/
launcher_assets/

# Logs and scratch
*.log
__pycache__/
