# Android runtime config, written by the start menu after the user selects
# their own disc image (it fills the disc placeholder).
[game]
name = "Contra - Legacy of War"
id = "SLUS-00288"
players = 1
exe = "disc/SLUS_002.88"
discs = [
  @@DISC1@@,
]
load_address = "0x80010000"
entry_pc = "0x800513E4"
text_size = "0x00094800"
stack_base = "0x801FFFF0"

[recompiler]
seeds = "seeds/ghidra_funcs.txt"
out_dir = "generated"
strict = true

[runtime]
video_renderer = "software"
overlay_cache = true
# OVER8 select-player compat: both 2-arg memset(dst,0x3C) wrappers dispatch
# A0:0x2B with $a2 never set (latent game bug — real HW ran on a register
# leftover, and under the recompiler it diverges, wrapping the fill over 2MB
# of RAM and clobbering the kernel dispatch stubs). Force the length the
# layout proves: each fill region ends exactly at the next structure
# (0x80100E0C+0x3C=0x80100E48, 0x80100E6C+0x3C=0x80100EA8). Values are the
# dispatch return addresses ($ra) of the two jal sites.
a0_memset_len_sites = [0x800FE590, 0x800FFD18]
a0_memset_len       = 0x3C
# DEV/PLAYTEST AID (temporary — delete these two lines to disable): per-frame
# GameShark-style freezes from the published SLUS-00288 codes. Infinite lives
# P1/P2 (0x800DC784/0x800DC7AC = 9), infinite continues (0x800DEC92 = 9),
# P1/P2 invincible (0x8008C9D4/0x8008CA9C = 0x60 — the flag the game checks).
cheat_freeze_addrs  = [0x800DC784, 0x800DC7AC, 0x800DEC92, 0x8008C9D4, 0x8008CA9C]
cheat_freeze_values = [0x0009,     0x0009,     0x0009,     0x0060,     0x0060]

[controller]
default_mode = "digital"

[bios]
path = "bios/openbios.bin"
